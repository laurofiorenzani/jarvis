# Copy to .env.jarvis and chmod 600. Never commit real values.
# Obtain the unified key from the private FreeLLMAPI dashboard.
FREELLMAPI_API_KEY=freellmapi-replace-with-unified-key

# Generate with: openssl rand -hex 32
# Store the same value in Supabase as FREELLMAPI_GATEWAY_TOKEN.
JARVIS_GATEWAY_TOKEN=replace-with-at-least-64-hex-characters

# Explicit named FreeLLMAPI profiles only; configure this profile with vetted providers.
FREELLMAPI_ALLOWED_MODELS=auto:jarvis-approved
